Imports Inventor
Imports System
Imports System.Collections.Generic
Imports System.Windows.Forms
Imports System.IO


Sub Main()

    Try

        ' ====================================================
        ' 1 - CRIAR ESTRUTURAS DE DADOS
        ' ====================================================

        Dim documentos As New Dictionary(Of String, Document)(
            StringComparer.OrdinalIgnoreCase)

        Dim framesPorArquivo As New Dictionary(Of String, List(Of String))(
            StringComparer.OrdinalIgnoreCase)

        Dim frameRows As New List(Of BOMRow)

        Dim listaErros As New List(Of String)

        ' ====================================================
        ' 2 - VERIFICAR DOCUMENTO ATIVO
        ' ====================================================

        Dim oDoc As Document = ThisApplication.ActiveDocument

        If oDoc.DocumentType <>
            DocumentTypeEnum.kAssemblyDocumentObject Then

            MessageBox.Show(
                "Execute esta regra em uma montagem IAM.",
                "Documento invalido")

            Return

        End If

        Dim asmDoc As AssemblyDocument =
            CType(oDoc, AssemblyDocument)

        ' ====================================================
        ' 3 - ACESSAR BOM MODEL DATA
        ' ====================================================

        Dim bom As BOM = asmDoc.ComponentDefinition.BOM

        bom.StructuredViewEnabled = True

        Dim modelDataView As BOMView = Nothing

        For Each bomView As BOMView In bom.BOMViews

            If BOMView.ViewType =
                BOMViewTypeEnum.kModelDataBOMViewType Then

                modelDataView = BOMView
                Exit For

            End If

        Next

        If modelDataView Is Nothing Then

            MessageBox.Show(
                "BOM Model Data nao encontrada.",
                "Erro")

            Return

        End If

        ' ====================================================
        ' 4 - LOCALIZAR FRAMES
        ' ====================================================

        For Each bomRow As BOMRow In modelDataView.BOMRows

            ColetarFramesRecursivo(
                BOMRow,
                frameRows,
                listaErros)

        Next

        If frameRows.Count = 0 Then

            MessageBox.Show(
                "Nenhum Frame foi encontrado.",
                "Informacao")

            Return

        End If

        ' ====================================================
        ' 5 - COLETAR IPTs DE TODOS OS FRAMES
        ' ====================================================

        For Each frameRow As BOMRow In frameRows

            Try

                Dim frameDoc As Document =
                    frameRow.ComponentDefinitions.Item(1).Document

                Dim framePN As String =
                    ObterPropriedade(
                        frameDoc,
                        "Design Tracking Properties",
                        "Part Number")

                Dim frameNome As String =
                    framePN & " [" & frameDoc.DisplayName & "]"

                If frameRow.ChildRows IsNot Nothing Then

                    For Each child As BOMRow In frameRow.ChildRows

                        ColetarPecasFrame(
                            child,
                            frameNome,
                            documentos,
                            framesPorArquivo,
                            listaErros)

                    Next

                End If

            Catch ex As Exception

                listaErros.Add(
                    "Erro ao acessar Frame: " & ex.Message)

            End Try

        Next

        ' ====================================================
        ' 6 - VALIDAR COLETA
        ' ====================================================

        If documentos.Count = 0 Then

            MessageBox.Show(
                "Nenhum arquivo IPT foi encontrado dentro dos Frames.",
                "Informacao")

            Return

        End If

        ' ====================================================
        ' 7 - CONTAR RELACIONAMENTOS
        ' ====================================================

        Dim quantidadeRelacionamentos As Integer = 0

        For Each kvp As KeyValuePair(Of String, List(Of String)) _
            In framesPorArquivo

            quantidadeRelacionamentos += kvp.Value.Count

        Next

        ' ====================================================
        ' 8 - RELATORIO
        ' ====================================================
		
' ====================================================
' 7.1 - EXPORTAR CAMINHOS DOS IPTs
' ====================================================

Dim pastaProcessamento As String =
    System.IO.Path.Combine(
        System.IO.Path.GetDirectoryName(asmDoc.FullFileName),
        "iLogic_Processamento")

If Not System.IO.Directory.Exists(pastaProcessamento) Then

    System.IO.Directory.CreateDirectory(pastaProcessamento)

End If

Dim arquivoColeta As String =
    System.IO.Path.Combine(
        pastaProcessamento,
        "IPTs_Coletados.csv")

Dim linhasColeta As New List(Of String)

linhasColeta.Add("CAMINHO")

For Each caminho As String In documentos.Keys

    linhasColeta.Add(caminho)

Next

System.IO.File.WriteAllLines(
    arquivoColeta,
    linhasColeta.ToArray(),
    System.Text.Encoding.UTF8)


        Dim relatorio As String = ""

        relatorio &=
            "MODULO 01 - COLETA GLOBAL CONCLUIDA" &
            vbCrLf & vbCrLf

        relatorio &=
            "Frames encontrados: " &
            frameRows.Count &
            vbCrLf

        relatorio &=
            "Arquivos IPT unicos: " &
            documentos.Count &
            vbCrLf

        relatorio &=
            "Relacionamentos IPT / Frame: " &
            quantidadeRelacionamentos &
            vbCrLf & vbCrLf

        relatorio &=
            "Part Numbers modificados: 0" &
            vbCrLf

        relatorio &=
            "Arquivos salvos: 0" &
            vbCrLf

        relatorio &=
            "Erros registrados: " &
            listaErros.Count

        If listaErros.Count > 0 Then

            relatorio &=
                vbCrLf & vbCrLf &
                "DETALHES DOS ERROS:" &
                vbCrLf &
                String.Join(
                    vbCrLf,
                    listaErros.ToArray())

        End If

        MessageBox.Show(
            relatorio,
            "Coleta Global de IPTs",
            MessageBoxButtons.OK,
            MessageBoxIcon.Information)

    Catch ex As Exception

        MessageBox.Show(
            "ERRO NA EXECUCAO DO MODULO 01" &
            vbCrLf & vbCrLf &
            ex.Message,
            "Erro",
            MessageBoxButtons.OK,
            MessageBoxIcon.Error)

    End Try

End Sub


' ============================================================
' 9 - LOCALIZAR FRAMES RECURSIVAMENTE
' ============================================================

Sub ColetarFramesRecursivo(
    bomRow As BOMRow,
    lista As List(Of BOMRow),
    listaErros As List(Of String))

    Try

        If bomRow.ComponentDefinitions.Count > 0 Then

            Dim doc As Document =
                bomRow.ComponentDefinitions.Item(1).Document

            Dim pn As String =
                ObterPropriedade(
                    doc,
                    "Design Tracking Properties",
                    "Part Number")

            If pn.StartsWith(
                "Skeleton",
                StringComparison.OrdinalIgnoreCase) Then

                Return

            End If

            If pn.StartsWith(
                "Frame",
                StringComparison.OrdinalIgnoreCase) Then

                lista.Add(bomRow)

            End If

        End If

    Catch ex As Exception

        listaErros.Add(
            "Erro na identificacao de BOM Row: " & ex.Message)

    End Try

    Try

        If bomRow.ChildRows IsNot Nothing Then

            For Each child As bomRow In bomRow.ChildRows

                ColetarFramesRecursivo(
                    child,
                    lista,
                    listaErros)

            Next

        End If

    Catch ex As Exception

        listaErros.Add(
            "Erro na leitura dos subniveis: " & ex.Message)

    End Try

End Sub


' ============================================================
' 10 - COLETAR IPTs DENTRO DOS FRAMES
' ============================================================

Sub ColetarPecasFrame(
    bomRow As BOMRow,
    frameNome As String,
    documentos As Dictionary(Of String, Document),
    framesPorArquivo As Dictionary(Of String, List(Of String)),
    listaErros As List(Of String))

    Try

        If bomRow.ComponentDefinitions.Count > 0 Then

            Dim primeiroDoc As Document =
                bomRow.ComponentDefinitions.Item(1).Document

            Dim pn As String =
                ObterPropriedade(
                    primeiroDoc,
                    "Design Tracking Properties",
                    "Part Number")

            If pn.StartsWith(
                "Skeleton",
                StringComparison.OrdinalIgnoreCase) Then

                Return

            End If

            For Each compDef As ComponentDefinition _
                In bomRow.ComponentDefinitions

                Try

                    Dim doc As Document = compDef.Document

                    If doc.DocumentType =
                        DocumentTypeEnum.kPartDocumentObject Then

                        Dim caminho As String = doc.FullFileName

                        If String.IsNullOrWhiteSpace(caminho) Then
                            Continue For
                        End If

                        If Not documentos.ContainsKey(caminho) Then

                            documentos.Add(
                                caminho,
                                doc)

                        End If

                        If Not framesPorArquivo.ContainsKey(caminho) Then

                            framesPorArquivo.Add(
                                caminho,
                                New List(Of String))

                        End If

                        If Not framesPorArquivo(caminho).Contains(frameNome) Then

                            framesPorArquivo(caminho).Add(frameNome)

                        End If

                    End If

                Catch ex As Exception

                    listaErros.Add(
                        "Erro na coleta de componente: " &
                        ex.Message)

                End Try

            Next

        End If

    Catch ex As Exception

        listaErros.Add(
            "Erro na leitura de pecas: " & ex.Message)

    End Try

    Try

        If bomRow.ChildRows IsNot Nothing Then

            For Each child As bomRow In bomRow.ChildRows

                ColetarPecasFrame(
                    child,
                    frameNome,
                    documentos,
                    framesPorArquivo,
                    listaErros)

            Next

        End If

    Catch ex As Exception

        listaErros.Add(
            "Erro na leitura dos subniveis das pecas: " &
            ex.Message)

    End Try

End Sub


' ============================================================
' 11 - LER PROPRIEDADES
' ============================================================

Function ObterPropriedade(
    doc As Document,
    conjunto As String,
    propriedade As String) As String

    Try

        Return CStr(
            doc.PropertySets.Item(conjunto).Item(propriedade).Value)

    Catch

        Return ""

    End Try

End Function

